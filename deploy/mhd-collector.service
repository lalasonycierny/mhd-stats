[Unit]
Description=mhd-stats collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mhd
WorkingDirectory=/opt/mhd-stats
ExecStart=/opt/mhd-stats/.venv/bin/python collector.py \
    --format json \
    --vehicles-url https://example.com/vehicles.json \
    --mapping mapping.json \
    --db /opt/mhd-stats/mhd.sqlite \
    --interval 60
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
